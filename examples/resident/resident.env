# Configuration of the resident start script (examples/resident/start-resident.sh).
# Install as /etc/atlas/resident.env, owned by root, mode 0644 (it holds no secrets: never put a login or
# an API key here). The script PARSES it as KEY=VALUE lines and never executes it. It refuses a file that is not owned by root (uid 0) or is
# writable by group/other: the human owns the trust level, the agent account must not be able to change it.
# Values with spaces need double quotes: RESIDENT_AUTH_CHECKS="codex login status". A value is a bare word or a "double-quoted
# string" without $, backtick, backslash or inner quote; any other line or key makes the script exit 2.
# SENTINEL_ATLAS set by the unit wins over this file.

# Working directory of the session; ~ is the home of the account that runs the unit (a subdirectory: Claude Code never saves trust for the home directory itself).
RESIDENT_DIR=~/resident
# Name of the screen session (`screen -ls`, `screen -r claude`).
RESIDENT_SESSION=claude
# Name shown in the Claude app / claude.ai/code (Remote Control).
RESIDENT_NAME=atlas-server
# TRUST LEVEL, passed as --permission-mode. You MUST choose; the script refuses to start while this is empty.
#   default            the agent asks you before risky actions (you answer from the Claude app)
#   acceptEdits        file edits are accepted without asking, other risky actions still ask
#   plan               the agent only plans and reads; it changes nothing
#   bypassPermissions  the agent acts WITHOUT asking: it runs any command the account may run, unattended.
#                      It also needs `--allow-dangerously-skip-permissions` in RESIDENT_EXTRA_ARGS.
RESIDENT_PERMISSION_MODE=
# Path to the claude binary; empty = found on PATH (systemd's PATH does not include ~/.local/bin: set it here).
RESIDENT_CLAUDE=~/.local/bin/claude
# Atlas state and code directories (installer defaults).
SENTINEL_ATLAS=/var/lib/atlas
ATLAS_CODE=/opt/atlas
# MODEL, passed as `--model <id>`. A Claude Code model id (for example claude-opus-5-5, claude-sonnet-5-5, claude-fable-5-1)
# or an alias the CLI accepts (opus, sonnet). Allowed form: ^[a-z0-9][a-z0-9.[]-]{1,63}$. Empty = the account's default.
# A wrong id stops the session at start: check it once by hand first: `claude --model <id> -p ok`.
RESIDENT_MODEL=
# EFFORT, passed as `--effort <level>`: low, medium, high, xhigh or max. Empty = the account's default.
RESIDENT_EFFORT=
# Extra claude flags, whitespace-separated, appended before the first prompt (one line, in double quotes). Empty by default.
# `--permission-mode bypassPermissions` ALSO needs `--allow-dangerously-skip-permissions`, otherwise claude may stop
# at a consent prompt with nobody watching. RISK: that combination removes the human approval step.
#   RESIDENT_EXTRA_ARGS="--allow-dangerously-skip-permissions"
RESIDENT_EXTRA_ARGS=
# Extra login checks, ';'-separated commands that must each exit 0 (their output is never shown), for example:
#   RESIDENT_AUTH_CHECKS="codex login status"
RESIDENT_AUTH_CHECKS=
