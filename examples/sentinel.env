# Atlas / Sentinel instance configuration: $SENTINEL_ATLAS/sentinel.env
#
# Format: KEY=VALUE, one per line. No shell code, no inline comments, optional "quotes".
# Read by every entrypoint (patrol.sh, jobs.sh, escalation.sh, session-sensor.sh, stream.py, atlas.py)
# and by the systemd units (EnvironmentFile=). A variable already set in the environment wins.
# SENTINEL_ATLAS itself is NOT set here: it selects the directory this file lives in (the units set it,
# cron sets it on the command line). Full reference: docs/configuration.md.

# --- Who hears about problems -------------------------------------------------------------------
# Recipient of the escalation mails (needs a working `mail` command / MTA on the host).
# Set this, SENTINEL_NOTIFY_CMD, or both. Both empty = nobody can be told: escalation logs
# "no recipient configured" and exits 2 (UNKNOWN).
SENTINEL_EMAIL=
# Notify channel, called as: <command> "<subject>" "<body>" (e.g. a push or chat CLI); counts as a recipient.
# Used by escalation (in addition to mail) and by the router (instead of mail) for critical events.
SENTINEL_NOTIFY_CMD=
# Alert mails are text + HTML through sendmail. Optional: the From: header, and the sendmail binary.
# SENTINEL_MAIL_FROM=
# SENTINEL_SENDMAIL_CMD=
# Language of the human-facing texts: en (default) or pl.
SENTINEL_LANG=en

# --- The optional AI resident -------------------------------------------------------------------
# How to tell that the AI agent watching this server is alive. Either sign is enough.
# Both empty = no resident: every critical event goes straight to the human, and escalation skips
# the "resident dead" check (and says so in its heartbeat).
SENTINEL_RESIDENT_UNIT=
SENTINEL_RESIDENT_SCREEN=

# --- Real-time stream ---------------------------------------------------------------------------
# sudo by these users is routine (info only, never wakes anyone). Comma or space separated.
# Do not put the AI agent's account here: use SENTINEL_AGENT_SUDO_USERS.
SENTINEL_TRUSTED_SUDO_USERS=root
# The account(s) the AI agent works under: their sudo is info (never wakes) and is listed in a daily digest
# that escalation sends to the human once a day at or after SENTINEL_DIGEST_HOUR (UTC hour, 0-23).
SENTINEL_AGENT_SUDO_USERS=
SENTINEL_DIGEST_HOUR=7
# Path(s) of the real sudo binary, comma separated: a journal line that claims to be sudo but was sent by
# another program is rejected (and reported as a rate-limited warning).
SENTINEL_SUDO_EXE=/usr/bin/sudo
# At most this many alert events wake the agent per hour (after the per-fingerprint dedup); 0 = no limit.
SENTINEL_WAKE_MAX_PER_HOUR=12
# Apache log of requests for sensitive paths (sentinel/apache/sentinel-sensitive.conf writes it).
SENTINEL_WEB_LOG=/var/log/apache2/sentinel-sensitive.log

# --- HTTP probes --------------------------------------------------------------------------------
# Where the enabled vhosts live. No such directory = no Apache = nothing to probe.
HTTP_SITES_DIR=/etc/apache2/sites-enabled

# --- Thresholds (atlas.py thresholds) -----------------------------------------------------------
# Choose them on your own data: replay snapshots/*.json and count how often a value would have fired.
ATLAS_DISK_PCT=90
ATLAS_RAM_MB=250
ATLAS_CERT_DAYS=14

# --- Optional external heartbeat ----------------------------------------------------------------
# Empty = no network call (the default). Set it to an http(s) URL that escalation fetches after every clean
# run (for example a healthchecks.io check): when the pings stop, that service tells you. Never logged.
SENTINEL_HEARTBEAT_URL=

# --- Your own contracts -------------------------------------------------------------------------
# Variables used by your jobs.d/ and bridges.d/ files can live here too, for example:
# NIGHTLY_BACKUP_LOG=/var/log/nightly-backup.log
# HOURLY_TASK_LOG=/var/log/hourly-task.log
